# Juan OS (Python) — local configuration
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.

# Neon Postgres connection string (required).
# Get it from the Neon console → your project → Connection string (pooled).
# Must allow SSL; if it doesn't already include sslmode, Juan OS adds sslmode=require.
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
