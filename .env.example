# Juan OS — local configuration. Copy to `.env` (gitignored) and fill in.
# NEVER commit real keys. Rotate any key that has been shared in plaintext.

# --- Analytics dashboard (juan_os) ---------------------------------------
# Neon Postgres connection string for the `python -m juan_os` dashboard.
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# --- Agent OS local database (juan_os.agent_os) --------------------------
# Optional: override the local SQLite path (defaults alongside the package).
# AGENT_OS_DB=/absolute/path/to/agent_os.db

# --- External providers (agents; all optional) ---------------------------
# Each is read at runtime; agents fall back to local simulation when unset.
EXA_API_KEY=              # Nova / Echo   — signal & public research
FIRECRAWL_API_KEY=        # Delta / Forge — verify + scrape public pages
APOLLO_API_KEY=           # Scout         — professional enrichment
CLEAROUT_API_KEY=         # Verity        — mailbox validation (token)
WARMY_API_KEY=            # Deliverability — inbox warmup
COMPOSIO_API_KEY=         # Tool Gateway  — connected external actions
COMPOSIO_ACCESS_TOKEN=    # Composio access token (if required by your setup)
# MX Guardian uses DNS (dnspython) — no key required.

# --- Model runtime / LLM (swappable; agents fall back to heuristics if unset) --
# Pick ONE backend; swap freely without code changes.
LLM_BACKEND=ollama            # ollama | openai | anthropic
# Ollama (local-first, default):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OpenAI-compatible (OpenAI, Groq, Together, OpenRouter, LM Studio, vLLM):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Anthropic / Claude (official SDK):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
